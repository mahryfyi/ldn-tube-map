{
  "$description": "Tube Map tokens. Source: Figma Playground, variable collection 'Tube Map' (modes: Light = default, Dark = later). Kept in sync by hand with tokens.css and tokens.ts. No opacity, width or blur tokens: those are code constants in line.config.ts.",
  "light": {
    "line": {
      "$type": "color",
      "bakerloo": { "$value": "#B36305", "$description": "Official TfL" },
      "central": { "$value": "#E32017", "$description": "Official TfL" },
      "district": { "$value": "#00782A", "$description": "Official TfL" },
      "jubilee": { "$value": "#A0A5A9", "$description": "Official TfL" },
      "northern": { "$value": "#000000", "$description": "Official TfL" },
      "piccadilly": { "$value": "#003688", "$description": "Official TfL" },
      "victoria": { "$value": "#0098D4", "$description": "Official TfL" },
      "waterloo-city": { "$value": "#95CDBA", "$description": "Official TfL" }
    },
    "line-dark": {
      "$type": "color",
      "$description": "Dark shade of each line: bead outline and train pill fill",
      "bakerloo": { "$value": "#493012" },
      "central": { "$value": "#491512" },
      "district": { "$value": "#124926" },
      "jubilee": { "$value": "#2C2E30" },
      "northern": { "$value": "#000000" },
      "piccadilly": { "$value": "#003688" },
      "victoria": { "$value": "#123A49" },
      "waterloo-city": { "$value": "#1D3E33" }
    },
    "map": {
      "$type": "color",
      "ground": { "$value": "#F3F1EC", "$description": "Reference mirror. Base-map colours live in the Mapbox Studio style" }
    },
    "station": {
      "$type": "color",
      "fill": { "$value": "#FFFFFF" },
      "stroke": { "$value": "#1A1A1A" }
    },
    "train": {
      "$type": "color",
      "fill": { "$value": "#1A1A1AEB", "$description": "92% opacity. Fallback. Each line's pill uses line-dark/<line>; Northern and Piccadilly use station/fill" },
      "arrow": { "$value": "#FFFFFF" }
    },
    "status": {
      "$type": "color",
      "good": { "bg": { "$value": "#1E7B45" }, "fg": { "$value": "#FFFFFF" } },
      "minor": { "bg": { "$value": "#E48F11" }, "fg": { "$value": "#FFFFFF" } },
      "severe": { "bg": { "$value": "#C9302A" }, "fg": { "$value": "#FFFFFF" } }
    }
  },
  "dark": {
    "line": {
      "$type": "color",
      "bakerloo": { "$value": "#E08A1E", "$description": "Lifted for dark ground. Official TfL: #B36305" },
      "central": { "$value": "#FF4A3D", "$description": "Lifted for dark ground. Official TfL: #E32017" },
      "district": { "$value": "#1FBF5B", "$description": "Lifted for dark ground. Official TfL: #00782A" },
      "jubilee": { "$value": "#8E959C", "$description": "Mid-grey to separate from Northern. Official TfL: #A0A5A9" },
      "northern": { "$value": "#F2F2F2", "$description": "Light core because black cannot glow. Official TfL: #000000" },
      "piccadilly": { "$value": "#3D7BFF", "$description": "Lifted for dark ground. Official TfL: #003688" },
      "victoria": { "$value": "#29B8F5", "$description": "Lifted for dark ground. Official TfL: #0098D4" },
      "waterloo-city": { "$value": "#95CDBA", "$description": "Same as official TfL" }
    },
    "line-dark": {
      "$type": "color",
      "$description": "Same as Light, unused in Dark",
      "bakerloo": { "$value": "#493012" },
      "central": { "$value": "#491512" },
      "district": { "$value": "#124926" },
      "jubilee": { "$value": "#2C2E30" },
      "northern": { "$value": "#000000" },
      "piccadilly": { "$value": "#003688" },
      "victoria": { "$value": "#123A49" },
      "waterloo-city": { "$value": "#1D3E33" }
    },
    "map": {
      "$type": "color",
      "ground": { "$value": "#0C0E12" }
    },
    "station": {
      "$type": "color",
      "fill": { "$value": "#FFFFFF" },
      "stroke": { "$value": "#0C0E12" }
    },
    "train": {
      "$type": "color",
      "fill": { "$value": "#0C0E12", "$description": "Drawn at 80% paint opacity (code constant, not a token)" },
      "arrow": { "$value": "#FFFFFF" }
    },
    "status": {
      "$type": "color",
      "good": { "bg": { "$value": "#1E7B45" }, "fg": { "$value": "#FFFFFF" } },
      "minor": { "bg": { "$value": "#E48F11" }, "fg": { "$value": "#FFFFFF" } },
      "severe": { "bg": { "$value": "#C9302A" }, "fg": { "$value": "#FFFFFF" } }
    }
  }
}
