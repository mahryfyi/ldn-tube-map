# Copy to .env.local and fill in. On the host (e.g. Vercel), set the same names
# in the project's environment variables.

# Mapbox public token (pk.…). Public by design, since it ships to the browser,
# so restrict it by URL in your Mapbox account: localhost plus your production domain.
NEXT_PUBLIC_MAPBOX_TOKEN=

# TfL Unified API key. SECRET: server only, never prefix it with NEXT_PUBLIC_.
# Optional: without it TfL still answers, with lower rate limits.
TFL_APP_KEY=

# Optional: your own Mapbox Studio style for the Light map.
# Unset = Mapbox Standard (monochrome), which is what the map uses today.
NEXT_PUBLIC_MAPBOX_STYLE_URL_LIGHT=

# Dark map style. Only read when THEME = "dark" in app/lib/line.config.ts.
NEXT_PUBLIC_MAPBOX_STYLE_URL=
